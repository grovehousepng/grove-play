<script>
window.spasibaData = {
  page: {
    type: {{ request.page_type | json }},
    template: {{ template.name | json }}
  },
  {% if product %}
  product: {
    id: {{ product.id | json }},
    title: {{ product.title | json }},
    vendor: {{ product.vendor | json }},
    type: {{ product.type | json }},
    price: {{ product.selected_or_first_available_variant.price | json }},
    compare_at_price: {{ product.selected_or_first_available_variant.compare_at_price | json }},
    variant_id: {{ product.selected_or_first_available_variant.id | json }},
    variant_title: {{ product.selected_or_first_available_variant.title | json }},
    sku: {{ product.selected_or_first_available_variant.sku | json }}
  },
  {% endif %}
  {% if collection %}
  collection: {
    id: {{ collection.id | json }},
    title: {{ collection.title | json }},
    products: [
      {% for product in collection.products limit: 10 %}
      {
        id: {{ product.id | json }},
        title: {{ product.title | json }},
        vendor: {{ product.vendor | json }},
        price: {{ product.price | json }},
        type: {{ product.type | json }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  {% endif %}
  {% if cart %}
  cart: {
    token: {{ cart.token | json }},
    total_price: {{ cart.total_price | json }},
    item_count: {{ cart.item_count | json }},
    items: [
      {% for item in cart.items %}
      {
        product_id: {{ item.product_id | json }},
        variant_id: {{ item.variant_id | json }},
        title: {{ item.title | json }},
        vendor: {{ item.vendor | json }},
        variant_title: {{ item.variant_title | json }},
        price: {{ item.price | json }},
        quantity: {{ item.quantity | json }},
        sku: {{ item.sku | json }},
        type: {{ item.product.type | json }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  {% endif %}
  {% if customer %}
  customer: {
    id: {{ customer.id | json }},
    email: {{ customer.email | json }},
    phone: {{ customer.phone | json }},
    first_name: {{ customer.first_name | json }},
    last_name: {{ customer.last_name | json }},
    address: {
      city: {{ customer.default_address.city | json }},
      country: {{ customer.default_address.country | json }},
      region: {{ customer.default_address.province | json }},
      zip: {{ customer.default_address.zip | json }}
    }
  }
  {% endif %}
};
</script>
