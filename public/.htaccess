<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS zorunlu hale getirmek istiyorsaniz asagidaki satirlarin basindaki # isaretini kaldirin
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Dizinlere (.html olmadan) dogrudan erisim - Trailing Slash aktif oldugu icin
  # Next.js export'u her route icin bir klasor ve altinda index.html uretir.
  # Apache bu klasorleri dogrudan gorur. Alt satirlar klasore gecisleri saglama alir.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Eger ozel bir HTML dosyasina erisim olursaysa uzantisiz haliyle calismasini saglar
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 404 sayfasi icin (Next.js'in out klasorunde urettigi 404.html gosterilir)
  ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_deflate.c>
  # Gzip Sıkıştırma
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>

<IfModule mod_expires.c>
  # Tarayici Önbellekleme
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
